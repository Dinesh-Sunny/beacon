# Beam model through an OpenAI-compatible endpoint (Hugging Face router by default)
BEAM_BASE_URL=
BEAM_MODEL=
HF_TOKEN=

# Limits for /api/check
BEACON_DAILY_CAP=500
BEACON_PER_IP_PER_MINUTE=5
BEACON_DAILY_TOKENS=30000000

# Optional LangSmith tracing. With tracing on, both HIDE values must be true (the app refuses otherwise),
# so answers, letters and model replies are never recorded.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Optional: where "This looks wrong" reports go
NEXT_PUBLIC_REPORT_EMAIL=
NEXT_PUBLIC_REPORT_ISSUES_URL=
