                "v": 4
              },
              {
                "f": "childAge",
                "op": "lte",
                "v": 10
              }
            ]
          },
          "expr": "a child at primary school",
          "txt": "A child at primary school",
          "fail": "No child at primary school"
        }
      ]
    },
