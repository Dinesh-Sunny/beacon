      "id": "pc",
      "name": "Pension Credit",
      "topic": "low",
      "by": "DWP",
      "gives": "A weekly top-up to your income. It opens the door to more help.",
      "how": "Claim by phone or online.",
      "phone": "0800 99 1234",
      "url": "https://www.gov.uk/pension-credit/how-to-claim",
      "timing": "Can be backdated up to 3 months, so claim soon.",
      "urgent": true,
      "rule": [
        {
          "needs": [
            "dob"
          ],
          "test": {
            "f": "spa",
            "op": "eq",
            "v": true
          },
          "expr": "reached State Pension age",
          "txt": "Reached State Pension age",
          "fail": "Under State Pension age"
        },
        {
          "needs": [
            "income"
          ],
          "test": {
            "f": "incWeek",
            "op": "lt",
            "v": {
              "line": "pcIncomeWeek"
            }
          },
          "expr": "weekly income under £238",
          "txt": "Income under the screening line",
          "fail": "Income likely above the line",
          "near": {
            "f": "incWeek",
            "line": "pcIncomeWeek"
          }
        }
      ],
      "opens": [
        "ctr",
        "cwp",
        "tv",
        "fep"
      ]
    },
    {
      "id": "uc",
      "name": "Universal Credit",
      "topic": "low",
      "by": "DWP",
