          },
          "expr": "savings £16,000 or less",
          "txt": "Savings £16,000 or less",
          "fail": "Savings over £16,000",
          "near": {
            "f": "sav",
            "line": "savingsCap"
          }
        },
        {
          "needs": [
            "income"
          ],
          "test": {
            "f": "incWeek",
            "op": "lt",
            "v": {
              "line": "ucIncomeWeek"
            }
          },
          "expr": "weekly income under £500",
          "txt": "Income under the screening line",
          "fail": "Income likely above the line",
          "near": {
