# Meta Model API (https://dev.meta.ai/docs/authentication). Names only, never commit values.
MODEL_API_KEY=
# Optional overrides
META_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
# Muse Wonder writes the call notes; Muse Spark answers if your key has no Wonder access
META_WONDER_MODEL=muse-wonder-1.0
# Open-weights privacy step: Muse Spark Open on Baseten by default. Without a key, the same
# rules run as plain code, so nothing personal leaves either way.
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026
# Fallback host: Muse Glimmer on Fireworks
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/muse-glimmer-30b
# Or any OpenAI-compatible host serving Muse Glimmer / Muse Spark Open (vLLM on Modal, Fireworks)
OPEN_WEIGHTS_BASE_URL=
OPEN_WEIGHTS_API_KEY=
OPEN_WEIGHTS_MODEL=
OPEN_WEIGHTS_NAME=
# Spend guard for the public demo
BEACON_DAILY_CAP=2000
BEACON_PER_IP_PER_MINUTE=20
# Public address of the deployed site, for share images, sitemap and robots
SITE_URL=
