{
  "name": "beacon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm copy:check",
    "eval": "pnpm --filter @beacon/brain eval",
    "snapshot": "pnpm --filter @beacon/rules snapshot",
    "copy:check": "python3 .claude/skills/direct-response-copywriting/scripts/voice-check.py check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3"
  }
}
