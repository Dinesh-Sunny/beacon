# Local only: where the Python sidecar runs (`pnpm dev:py`). On Vercel the service binding sets BACKEND_INTERNAL_URL instead.
PYTHON_API_URL=http://127.0.0.1:8000

# AI agents (python/api) call models through Vercel AI Gateway. Locally: an API key (Vercel
# dashboard → AI Gateway → API keys). On Vercel the deployment's OIDC token is used, so leave it
# unset there. Unset everywhere: the assistant reports AI as not configured. docs/knowledge/ai.md
AI_GATEWAY_API_KEY=
# Agent tracing (Langfuse Cloud). Off unless both keys are set; LANGFUSE_BASE_URL picks the region
# (https://cloud.langfuse.com for EU, https://us.cloud.langfuse.com for US).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Canonical origin for SEO (metadataBase, sitemap, robots, OG URLs), e.g. https://example.com.
# Read at BUILD time: pages prerender, so setting it only at runtime has no effect.
# Optional on Vercel: falls back to VERCEL_PROJECT_PRODUCTION_URL. Unset elsewhere, the site uses
# http://localhost:3000 and stays noindex, so self-hosted production builds must set it.
SITE_URL=
# Multi-tenancy (docs/adr/0002-multi-tenancy.md): subdomains of this domain name tenants by slug
# (acme.sites.example.com). Unset: only domains listed on a tenant pick it; other hosts are the
# default site.
TENANT_BASE_DOMAIN=

# Postgres. Defaults point at the local Docker database (`pnpm db:up`); `pnpm setup` copies this
# file to .env.local. Neon's Vercel integration injects both on Vercel; for PlanetScale set them
# by hand. The Python sidecar reads the same values. See docs/knowledge/database.md.
# Pooled endpoint for app queries (Neon: the -pooler host; PlanetScale: port 6432).
DATABASE_URL=postgresql://__NAME__:__NAME__@localhost:5432/__NAME__
# Direct endpoint for migrations and session features (Neon: host without -pooler; PlanetScale: port 5432).
DATABASE_URL_UNPOOLED=postgresql://__NAME__:__NAME__@localhost:5432/__NAME__
# Rate limits (Upstash Redis). Defaults point at the local Serverless Redis HTTP container
# (`pnpm db:up`). On Vercel the Upstash Marketplace integration sets KV_REST_API_URL and
# KV_REST_API_TOKEN instead; either pair works. See docs/knowledge/rate-limits.md.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=__NAME__-local-token
# Vercel only: set to 1 where deploy builds should run migrations (Production; Preview only with
# per-preview database branches). Locally and in CI run `pnpm db:migrate` instead.
# DB_MIGRATE_ON_BUILD=

# Payload CMS. Signs admin sessions and tokens: a long random string per environment
# (`openssl rand -hex 32`), never shared between environments. Required at runtime.
PAYLOAD_SECRET=

# Media storage (S3-compatible; Cloudflare R2 by default). Leave S3_BUCKET empty to store uploads
# on local disk (development only: Vercel's disk doesn't persist). For R2: endpoint is
# https://<account-id>.r2.cloudflarestorage.com and region stays "auto". The bucket's CORS rules
# must allow PUT from the site origin (browser uploads go straight to the bucket).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket's custom domain (served by the CDN), e.g. https://media.example.com
MEDIA_PUBLIC_URL=

# Local development only: test CMS admin used by tooling and manual checks. Never set in Vercel.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/payload-jobs/run (scheduled
# publish). Set a long random value in Vercel; locally staff can run jobs while logged in.
CRON_SECRET=

# Better Auth (app users). Secret signs sessions and encrypts JWT keys: `openssl rand -hex 32`,
# different per environment. URL is the canonical origin (production domain); previews on
# *.vercel.app and localhost are accepted automatically.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Organization billing (Stripe). Both or neither; empty means every organization is on the free
# tier. On Vercel the Stripe Marketplace integration sets the key. Locally the webhook secret
# comes from `stripe listen --forward-to localhost:3000/api/auth/stripe/webhook`.
# See docs/knowledge/payments.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shop payments (Stripe Checkout, same account as billing). A second webhook endpoint with its own
# signing secret; without it the shop webhook answers 503 and no order is created. Locally:
# `stripe listen --forward-to localhost:3000/api/payments/stripe-checkout/webhooks`.
# See docs/knowledge/commerce.md.
SHOP_STRIPE_WEBHOOK_SECRET=

# Email (Amazon SES). Set EMAIL_FROM and AWS_SES_REGION to send for real; leave them empty locally
# and emails print to the server log (production refuses to start sending without them). The
# sender's domain must be a verified SES identity in that region. Credentials come from the AWS
# SDK default chain: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for an IAM user allowed only
# ses:SendEmail. See docs/knowledge/email.md.
EMAIL_FROM=
EMAIL_REPLY_TO=
AWS_SES_REGION=
# Optional: SES configuration set that routes delivery, bounce, and complaint events.
AWS_SES_CONFIGURATION_SET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Error tracking (Sentry). The DSN is public by design and serves browser, server, and edge; leave
# it empty to keep Sentry off. NEXT_PUBLIC_ values are inlined at build time, so set them before
# building. Source maps upload only when SENTRY_AUTH_TOKEN is set (CI / Vercel build env only).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Python sidecar's own Sentry project (can be the same DSN).
SENTRY_DSN=

# Product analytics (PostHog Cloud). Empty key: analytics off. Region is eu (default) or us and
# picks the hosts /ingest forwards to. Nothing is captured until the visitor's consent choice.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_REGION=eu
# Account deletion also deletes the PostHog person and their events (docs/knowledge/compliance.md).
# A personal API key with the person:write scope on this project. Unset: that step is skipped.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Google Analytics 4 measurement id (G-XXXXXXX). Empty: GA4 off. Loads only after the visitor
# accepts measurement cookies; consent choices are stored by our own backend at /api/c15t.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
