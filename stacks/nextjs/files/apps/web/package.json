    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@sentry/nextjs": "^11.7.0",
    "better-auth": "1.7.7",
    "botid": "1.5.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
