    "@c15t/nextjs": "2.3.0",
    "@c15t/scripts": "2.3.0",
    "@__NAME__/auth": "workspace:*",
    "@__NAME__/db": "workspace:*",
    "@__NAME__/email": "workspace:*",
    "@__NAME__/ratelimit": "workspace:*",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
