{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && payload generate:types && payload generate:importmap && tsc --noEmit",
    "payload": "payload",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "cms:migrate:create": "payload migrate:create",
    "migrate": "payload run src/scripts/migrate.ts",
    "migrate:deploy": "payload run src/scripts/migrate.ts deploy",
    "test": "node --env-file-if-exists=.env.local --test \"src/**/*.test.ts\"",
    "consent:schema": "node src/scripts/generate-consent-schema.ts",
    "verify:commerce": "payload run src/scripts/verify-commerce.ts"
  },
  "dependencies": {
