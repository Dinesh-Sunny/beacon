{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm run *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm lint:js)",
      "Bash(pnpm lint:py)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm check)",
      "Bash(pnpm build)",
      "Bash(pnpm format)",
      "Bash(pnpm dev)",
      "Bash(pnpm dev:py)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm exec biome *)",
      "Bash(pnpm list *)",
      "Bash(pnpm why *)",
      "Bash(pnpm outdated *)",
      "Bash(pnpm dlx shadcn@latest add *)",
      "Bash(pnpm dlx shadcn@latest view *)",
      "Bash(pnpm dlx shadcn@latest search *)",
      "Bash(pnpm dlx shadcn@latest info *)",
      "Bash(pnpm dlx shadcn@latest diff *)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy)",
      "Bash(uv run mypy *)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv lock --check)",
      "Bash(uv tree *)",
      "Bash(uv pip list *)",
      "Bash(uv python list *)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:pnpm.io)",
      "WebFetch(domain:biomejs.dev)",
      "WebFetch(domain:ui.shadcn.com)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm dlx *)",
      "Bash(npx *)",
      "Bash(vercel *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock --upgrade *)",
      "Bash(uv pip install *)",
      "Bash(pnpm design:check)",
      "Bash(pnpm copy:check)",
      "Bash(pnpm exec impeccable *)",
      "Bash(npx impeccable *)",
      "WebFetch(domain:impeccable.style)",
      "Bash(pnpm design:sync)",
      "Bash(pnpm design:tokens)"
    ],
    "ask": [],
    "deny": [
      "Bash(npm install *)",
      "Bash(yarn *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)"
    ]
  },
  "env": {
    "CLAUDE_HOOK_FORMAT_MAP": "py=uv run ruff format --quiet;ts,tsx,js,jsx,mjs,cjs,json,jsonc,css=pnpm exec biome check --write --no-errors-on-unmatched",
    "CLAUDE_HOOK_STOP_CHECK_CMD": "pnpm lint && pnpm typecheck",
    "+CLAUDE_HOOK_PROTECTED_GLOBS": ":uv.lock:.venv/*:*/node_modules/*:node_modules/*:*/.next/*:next-env.d.ts:*/next-env.d.ts",
    "CLAUDE_DESIGN_GATE": "1"
  },
  "enabledMcpjsonServers": [
    "next-devtools",
    "shadcn"
  ],
  "sandbox": {
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "enabledPlugins": {
    "impeccable@impeccable": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design-gate.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design-tokens.sh",
            "timeout": 20,
            "statusMessage": "Checking design tokens"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/voice-check.sh",
            "timeout": 20,
            "statusMessage": "Checking copy voice"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design-gate.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
